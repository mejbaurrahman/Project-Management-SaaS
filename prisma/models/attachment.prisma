model Attachment {
  id           String @id @default(uuid())
  fileName     String
  fileUrl      String
  publicId     String?

  taskId       String
  uploadedById String

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([uploadedById])
  @@index([deletedAt])
}